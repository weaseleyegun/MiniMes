{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "MesApi": {
    "BaseUrl": "http://localhost:5168"
  },
  "Collector": {
    "IntervalSeconds": 3,
    "Equipments": [ "CNC-01", "CNC-02" ]
  },
  "Cycle": {
    "IntervalMs": 5000,
    "BackfillCount": 3000,
    "ExcludeItemCodes": [ "EM-S-14", "EM-AL-12" ]
  }
}
